          "rawSql": "SELECT date_trunc('day', fetched_at) AS time, source_label AS metric, count(*) AS value\n        FROM news.cig_watch_entries WHERE $__timeFilter(fetched_at) GROUP BY 1, 2 ORDER BY 1",
