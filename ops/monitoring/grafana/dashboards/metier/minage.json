    {
      "type": "timeseries",
      "title": "Ventes et frais par semaine (aUEC)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT date_trunc('week', sh.session_date) AS time, sum(sa.amount) AS \"Ventes\"\n               FROM session.sales sa JOIN session.sheets sh ON sh.id = sa.sheet_id\n               WHERE $__timeFilter(sh.session_date) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "B",
          "rawSql": "SELECT date_trunc('week', sh.session_date) AS time, sum(ex.amount) AS \"Frais avancés\"\n               FROM (SELECT sheet_id, payer_user_id, kind, amount FROM session.expenses\n       UNION ALL SELECT sheet_id, launcher_user_id, 'REFINING', cost FROM mining.refinery_orders WHERE cost > 0) ex JOIN session.sheets sh ON sh.id = ex.sheet_id\n               WHERE $__timeFilter(sh.session_date) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
