    {
      "type": "table",
      "title": "Fiches de la période",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Ventes vides : aucune vente saisie. Virements reçus : confirmés sur le total du règlement en cours.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT sh.session_date AS \"Date\", sh.name AS \"Fiche\", o.username AS \"Organisateur\",\n               CASE sh.status WHEN 'ACTIVE' THEN 'En cours' WHEN 'SETTLEMENT' THEN 'En règlement' ELSE 'Clôturée' END AS \"Statut\",\n               (SELECT count(*) FROM session.participants pa WHERE pa.sheet_id = sh.id) AS \"Participants\",\n               (SELECT sum(amount) FROM session.sales sa WHERE sa.sheet_id = sh.id) AS \"Ventes\",\n               (SELECT sum(amount) FROM (SELECT sheet_id, payer_user_id, kind, amount FROM session.expenses\n       UNION ALL SELECT sheet_id, launcher_user_id, 'REFINING', cost FROM mining.refinery_orders WHERE cost > 0) ex WHERE ex.sheet_id = sh.id) AS \"Frais avancés\",\n               (SELECT sum(amount) FROM session.sales sa WHERE sa.sheet_id = sh.id)\n                 - coalesce((SELECT sum(amount) FROM (SELECT sheet_id, payer_user_id, kind, amount FROM session.expenses\n       UNION ALL SELECT sheet_id, launcher_user_id, 'REFINING', cost FROM mining.refinery_orders WHERE cost > 0) ex WHERE ex.sheet_id = sh.id), 0) AS \"Net\",\n               (SELECT CASE WHEN count(*) > 0 THEN count(*) FILTER (WHERE t.received_at IS NOT NULL) || ' / ' || count(*) END\n                  FROM session.settlement_transfers t JOIN session.settlements s ON s.id = t.settlement_id\n                 WHERE s.sheet_id = sh.id AND s.cancelled_at IS NULL) AS \"Virements reçus\"\n        FROM session.sheets sh JOIN core.users o ON o.id = sh.organizer_user_id\n        WHERE $__timeFilter(sh.session_date) ORDER BY sh.session_date DESC, sh.name LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Date"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ventes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              },
              {
                "id": "displayName",
                "value": "Ventes (aUEC)"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Frais avancés"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              },
              {
                "id": "displayName",
                "value": "Frais avancés (aUEC)"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Net"
            },
            "properties": [
              {
                "id": "unit",
                "value": "locale"
              },
              {
