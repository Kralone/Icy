    {
      "type": "table",
      "title": "Objectifs en cours",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT g.name AS \"Objectif\", coalesce(u.username, 'Organisation') AS \"Porteur\",\n               g.current AS \"Atteint\", g.target AS \"Cible\",\n               round(g.current::numeric / nullif(g.target, 0), 3) AS \"Avancement\",\n               g.created_at AS \"Créé le\"\n        FROM goals.goals g LEFT JOIN core.users u ON u.id = g.user_id\n        WHERE NOT g.completed ORDER BY g.pinned DESC, 5 DESC NULLS LAST LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
