    {
      "type": "table",
      "title": "Opérations de la période",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Places : somme des capacités des groupes, vide si un groupe n'a pas de capacité définie.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT e.start_date_time AS \"Début\", e.title AS \"Opération\",\n               CASE o.publication_status WHEN 'DRAFT' THEN 'Brouillon' ELSE 'Publiée' END AS \"Statut\",\n               (SELECT count(*) FROM events.operation_groups g WHERE g.operation_event_id = e.id) AS \"Groupes\",\n               (SELECT count(*) FROM events.operation_assignments a\n                 WHERE a.operation_event_id = e.id AND a.status = 'CONFIRMED') AS \"Affectés\",\n               (SELECT count(*) FROM events.operation_assignments a\n                 WHERE a.operation_event_id = e.id AND a.status = 'PENDING') AS \"En attente\",\n               (SELECT CASE WHEN count(*) = count(capacity) THEN sum(capacity) END\n                  FROM events.operation_groups g WHERE g.operation_event_id = e.id) AS \"Places\",\n               (SELECT coalesce(sum(quantity), 0) FROM events.operation_ship_requirements r\n                 WHERE r.operation_event_id = e.id AND r.status <> 'CANCELLED') AS \"Vaisseaux demandés\",\n               (SELECT count(*) FROM events.operation_ship_proposals sp\n                 WHERE sp.operation_event_id = e.id AND sp.status = 'ACCEPTED') AS \"Vaisseaux acceptés\"\n        FROM events.operations o JOIN events.events e ON e.id = o.event_id\n        WHERE $__timeFilter(e.start_date_time) ORDER BY e.start_date_time DESC LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Début"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Réponses aux demandes de place",
      "datasource": {
