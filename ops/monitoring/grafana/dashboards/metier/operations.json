          "refId": "A",
          "rawSql": "SELECT CASE r.status WHEN 'PENDING' THEN 'En attente' WHEN 'APPROVED' THEN 'Acceptée' WHEN 'REFUSED' THEN 'Refusée'\n                             WHEN 'CANCELLED' THEN 'Annulée' ELSE r.status END AS metric, count(*) AS value\n        FROM events.operation_assignment_requests r JOIN events.events e ON e.id = r.operation_event_id\n        WHERE $__timeFilter(e.start_date_time) GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
