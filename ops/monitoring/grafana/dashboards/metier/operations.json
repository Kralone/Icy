      "title": "Modèles d'équipage utilisés",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Modèles appliqués au moins une fois, sur le nombre de modèles non archivés.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT count(DISTINCT g.crew_preset_id) || ' / ' || (SELECT count(*) FROM events.operation_crew_presets WHERE NOT archived)\n        FROM events.operation_groups g WHERE g.crew_preset_id IS NOT NULL",
