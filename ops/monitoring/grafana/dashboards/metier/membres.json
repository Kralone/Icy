    {
      "type": "barchart",
      "title": "Heures de connexion (heure de Paris)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Pour chaque heure : combien de fois un membre était connecté à cette heure-là (un membre compte une fois par jour). Utile pour choisir l'horaire des événements.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT lpad(h::text, 2, '0') || ' h' AS metric,\n               (SELECT count(DISTINCT (user_id, (created_at AT TIME ZONE 'Europe/Paris')::date)) FROM core.refresh_tokens\n                 WHERE $__timeFilter(created_at) AND extract(hour FROM created_at AT TIME ZONE 'Europe/Paris') = h) AS value\n        FROM generate_series(0, 23) AS h ORDER BY h",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "metric": "Heure",
              "value": "Connexions"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Pas de donnée",
          "min": 0,
          "color": {
