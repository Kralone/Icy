    {
      "type": "table",
      "title": "Dernières synchronisations",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT created_at AS \"Lancée\", operation AS \"Opération\", coalesce(scope, 'Tout') AS \"Périmètre\",\n               CASE status WHEN 'SUCCEEDED' THEN 'Réussie' WHEN 'FAILED' THEN 'Échec' WHEN 'RUNNING' THEN 'En cours'\n                           WHEN 'QUEUED' THEN 'En file' WHEN 'WAITING_FOR_REVIEW' THEN 'À arbitrer' ELSE status END AS \"Statut\",\n               extract(epoch FROM completed_at - started_at) AS \"Durée\", message AS \"Message\"\n        FROM catalog.sync_runs ORDER BY created_at DESC LIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Lancée"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Durée"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Statut"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "text"
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Réussie": {
                        "color": "green"
                      },
                      "Échec": {
                        "color": "red"
                      },
                      "À arbitrer": {
                        "color": "orange"
                      },
                      "En cours": {
                        "color": "blue"
                      },
                      "En file": {
                        "color": "blue"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
