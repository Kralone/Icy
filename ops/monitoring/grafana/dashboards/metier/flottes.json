          "refId": "A",
          "rawSql": "SELECT date_trunc('month', created_at) AS time, count(*) AS \"Vaisseaux ajoutés\"\n        FROM fleet.user_ships WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
