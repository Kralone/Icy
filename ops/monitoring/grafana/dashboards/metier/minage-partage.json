      "title": "Délai moyen jusqu'à la clôture",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "De la création de la fiche à sa clôture : ventes, partage et confirmation de tous les virements.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT avg(extract(epoch FROM h.at - sh.created_at)) FROM session.sheets sh\n        JOIN session.history h ON h.sheet_id = sh.id AND h.action IN ('CLOSED', 'FORCED_CLOSE')\n        WHERE $__timeFilter(sh.session_date)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
