    {
      "type": "table",
      "title": "Virements entre participants",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT sh.session_date AS \"Date\", sh.name AS \"Fiche\", f.username AS \"Verse\", t2.username AS \"Reçoit\",\n               t.amount AS \"Montant\",\n               CASE WHEN t.received_at IS NULL THEN 'En attente' ELSE 'Reçu' END AS \"État\",\n               t.received_at AS \"Confirmé le\"\n        FROM session.settlement_transfers t\n        JOIN session.settlements s ON s.id = t.settlement_id JOIN session.sheets sh ON sh.id = s.sheet_id\n        JOIN core.users f ON f.id = t.from_user_id JOIN core.users t2 ON t2.id = t.to_user_id\n        WHERE s.cancelled_at IS NULL AND $__timeFilter(sh.session_date)\n        ORDER BY (t.received_at IS NULL) DESC, sh.session_date DESC, t.position LIMIT 200",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—",
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Date"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
