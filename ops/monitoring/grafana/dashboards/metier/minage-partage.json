    {
      "type": "table",
      "title": "Part du bénéfice attribuée par membre",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Règlements en cours : part attribuée, que ses virements soient reçus ou non. Hors remboursement des frais avancés.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT u.username AS metric, sum(ss.share) AS value\n        FROM session.settlement_shares ss JOIN session.settlements s ON s.id = ss.settlement_id\n        JOIN session.sheets sh ON sh.id = s.sheet_id JOIN core.users u ON u.id = ss.user_id\n        WHERE s.cancelled_at IS NULL AND $__timeFilter(sh.session_date) GROUP BY 1 ORDER BY 2 DESC, 1 LIMIT 30",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "transformations": [
