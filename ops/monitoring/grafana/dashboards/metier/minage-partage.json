    {
      "type": "table",
      "title": "Étapes et corrections",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Réouvertures et clôtures forcées signalent des comptes corrigés après coup ou des virements jamais confirmés.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT CASE h.action WHEN 'SETTLED' THEN 'Comptes arrêtés' WHEN 'CLOSED' THEN 'Clôtures'\n                             WHEN 'FORCED_CLOSE' THEN 'Clôtures forcées' WHEN 'REOPENED_SETTLEMENT' THEN 'Réouvertures du règlement'\n                             WHEN 'REOPENED_ACTIVE' THEN 'Retours en cours' WHEN 'RECEIPT_CONFIRMED' THEN 'Virements confirmés'\n                             WHEN 'RECEIPT_WITHDRAWN' THEN 'Confirmations retirées' ELSE h.action END AS metric, count(*) AS value\n        FROM session.history h JOIN session.sheets sh ON sh.id = h.sheet_id\n        WHERE $__timeFilter(sh.session_date) GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "metric": "Étape",
              "value": "Nombre"
            }
          }
        }
      ],
      "fieldConfig": {
