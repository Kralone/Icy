    {
      "type": "table",
      "title": "Frais avancés et remboursement",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Photographie de l'arrêt des comptes. Dû au participant = part du bénéfice + remboursement de ses frais avancés. Il a déjà encaissé ses propres ventes : la différence est réglée par virements.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT sh.session_date AS \"Date\", sh.name AS \"Fiche\", u.username AS \"Participant\",\n               ss.shares_centi / 100.0 AS \"Parts\", ss.share AS \"Part du bénéfice\", ss.advanced AS \"Frais avancés\",\n               ss.balance AS \"Dû au participant\", ss.cashed AS \"Ventes encaissées\",\n               ss.balance - ss.cashed AS \"Reste à recevoir (+) ou à verser (−)\"\n        FROM session.settlement_shares ss\n        JOIN session.settlements s ON s.id = ss.settlement_id JOIN session.sheets sh ON sh.id = s.sheet_id\n        JOIN core.users u ON u.id = ss.user_id\n        WHERE s.cancelled_at IS NULL AND $__timeFilter(sh.session_date)\n        ORDER BY sh.session_date DESC, sh.name, ss.position LIMIT 200",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
