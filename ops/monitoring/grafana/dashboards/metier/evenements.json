    {
      "type": "stat",
      "title": "Présents par événement passé",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Moyenne des réponses « présent ». C'est une intention annoncée, pas une présence vérifiée.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT round(count(p.id) FILTER (WHERE p.status = 1)::numeric / nullif(count(DISTINCT e.id), 0), 1)\n        FROM events.events e LEFT JOIN events.event_participation p ON p.event_id = e.id\n        WHERE $__timeFilter(e.start_date_time) AND e.start_date_time <= localtimestamp",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Pas de donnée",
