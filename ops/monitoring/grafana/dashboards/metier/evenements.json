    {
      "type": "table",
      "title": "Prochains événements",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Affectés : membres placés dans un groupe de l'opération (vide pour un événement simple).",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT e.start_date_time AS \"Début\", e.title AS \"Titre\", coalesce(e.event_type, CASE e.activity_type WHEN 'OPERATION' THEN 'Opération' ELSE 'Sans type' END) AS \"Type\",\n               CASE WHEN o.event_id IS NULL THEN 'Événement'\n                    WHEN o.publication_status = 'DRAFT' THEN 'Opération (brouillon)' ELSE 'Opération' END AS \"Nature\",\n               count(p.id) FILTER (WHERE p.status = 1) AS \"Présents\",\n               count(p.id) FILTER (WHERE p.status = 0) AS \"Peut-être\",\n               count(p.id) FILTER (WHERE p.status = -1) AS \"Absents\",\n               (SELECT count(*) FROM events.operation_assignments a\n                 WHERE a.operation_event_id = e.id AND a.status = 'CONFIRMED') AS \"Affectés\"\n        FROM events.events e\n        LEFT JOIN events.operations o ON o.event_id = e.id\n        LEFT JOIN events.event_participation p ON p.event_id = e.id\n        WHERE e.start_date_time > localtimestamp AND NOT e.finished\n        GROUP BY e.id, o.event_id, o.publication_status ORDER BY e.start_date_time LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Pas de donnée",
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Début"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
