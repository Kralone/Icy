    {
      "type": "table",
      "title": "Événements Star Citizen",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "refId": "A",
          "rawSql": "SELECT w.start_at AS \"Début\", w.title AS \"Événement\", w.type_name AS \"Type\",\n               count(p.id) FILTER (WHERE p.status = 1) AS \"Confirmés\",\n               count(p.id) FILTER (WHERE p.status = 0) AS \"Peut-être\",\n               coalesce(sum(p.total) FILTER (WHERE p.status = 1), 0) AS \"Points des confirmés\"\n        FROM scworld.sc_world_event w LEFT JOIN scworld.sc_world_event_participation p ON p.scwe_id = w.id\n        WHERE $__timeFilter(w.start_at) GROUP BY w.id ORDER BY w.start_at DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
