          "rawSql": "SELECT u.username AS metric, count(*) AS value\n        FROM events.event_participation p JOIN events.events e ON e.id = p.event_id JOIN core.users u ON u.id = p.user_id\n        WHERE p.status = 1 AND $__timeFilter(e.start_date_time) AND e.start_date_time <= localtimestamp\n        GROUP BY 1 ORDER BY 2 DESC, 1 LIMIT 30",
