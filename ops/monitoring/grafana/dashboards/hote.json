      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Pas de donnée",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
