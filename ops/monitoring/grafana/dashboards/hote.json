{
  "uid": "iceforge-hote",
  "title": "Hôte et conteneurs",
  "description": "Ressources du serveur (node-exporter) et de chaque conteneur (cAdvisor).",
  "tags": [
    "iceforge"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "project",
        "label": "Projet",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen, project)",
          "refId": "var"
        },
        "definition": "label_values(container_last_seen, project)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{project=~\"$project\"}, service)",
          "refId": "var"
        },
        "definition": "label_values(container_last_seen{project=~\"$project\"}, service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "iceforge"
      ],
      "asDropdown": true,
