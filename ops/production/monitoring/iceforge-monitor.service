[Unit]
Description=Surveillance IceForge et alertes mail/Discord
After=docker.service network-online.target
Wants=network-online.target
# Au moins un canal d'alerte configuré (« | » : l'une ou l'autre condition suffit).
ConditionPathExists=|/etc/iceforge-monitor/config.json
ConditionPathExists=|/etc/iceforge-monitor/discord.json

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /root/iceforge/ops/production/monitoring/production-monitor.py check
TimeoutStartSec=90
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/iceforge-monitor
