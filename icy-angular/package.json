{
  "name": "icy-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:audit": "ng serve --configuration audit",
    "build": "node update-version.js && node generate-sitemap.js && ng build",
    "build:production": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "start-lan": "ng serve --host 0.0.0.0",
    "serve:ssr:icy-angular": "node dist/icy-angular/server/server.mjs"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@angular/ssr": "^22.2.3",
    "@fullcalendar/angular": "^6.1.22",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.22",
    "@kolkov/angular-editor": "^3.4.0",
    "@ngneat/overview": "8.1.0",
    "@ngxpert/hot-toast": "7.0.0",
    "@stomp/rx-stomp": "^2.4.0",
    "@stomp/stompjs": "^7.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "emoji-picker-element": "^1.29.1",
    "express": "5.3.0",
    "lightningcss": "^1.33.0",
    "marked": "^18.1.1",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.3.0",
    "uuid": "^14.0.3",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
